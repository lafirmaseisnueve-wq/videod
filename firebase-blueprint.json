{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account information and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Project": {
      "title": "Storyboard Project",
      "description": "A complete music video storyboard with creative brief and shot list",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "object" },
        "songDescription": { "type": "string" },
        "directorId": { "type": "string" },
        "videoType": { "type": "string" },
        "aspectRatio": { "type": "string" },
        "creativeBrief": { "type": "object" },
        "clips": { "type": "array" }
      },
      "required": ["userId", "title", "createdAt", "creativeBrief", "clips"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Music video storyboard projects"
    }
  }
}
